#Merge Sort: A sorting algorithm that sorts recurisively. Takes apart and array into 2 sides.
#Recurisivly sorts the 2 sides seperately using mergeSort. Then merges those 2 sorted arrays
#together.

def merge(left, right):
  ans = []
  i = 0
  j = 0
  while i < len(left) and j < len(right):
    if left[i] < right[j]:
      ans.append(left[i])
      i += 1
    else:
      ans.append(right[j])
      j += 1
  ans.extend(left[i:])
  ans.extend(right[j:])
  return ans

def mergeSort(a):
  if len(a) <= 1:
    return a

  mid = len(a) // 2
  left = a[:mid]
  right = a[mid:]

  leftSorted = mergeSort(left)
  rightSorted = mergeSort(right)

  return merge(leftSorted, rightSorted)



